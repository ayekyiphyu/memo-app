# Hide HTML and CSS from GitHub language detection
*.html linguist-detectable=false
*.css linguist-detectable=false
*.scss linguist-detectable=false
*.sass linguist-detectable=false

# Mark build/generated directories as generated code
public/* linguist-generated
.next/* linguist-generated
out/* linguist-generated
build/* linguist-generated
dist/* linguist-generated

# Explicitly prioritize TypeScript/JavaScript
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript
*.js linguist-language=JavaScript
*.jsx linguist-language=JavaScript

# Mark package files as configuration
package.json linguist-language=JSON
package-lock.json linguist-generated
yarn.lock linguist-generated
pnpm-lock.yaml linguist-generated

# More aggressive HTML hiding
*.html linguist-vendored
*.htm linguist-vendored